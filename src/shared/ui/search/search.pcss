.search {
    min-width: 0;
    &__label {
        display: block;
        font-family: var(--font-source-serif);
        font-size: 3.5rem;
        margin-bottom: 2rem;
    }
    &__input {
        position: relative;
    }
    &__field {
        width: 100%;
        min-height: 52px;
        padding: 1.5rem 5.5rem 1.5rem 1.5rem;
        border: 1px solid var(--wedding-line);
        border-radius: 4px;
        background: var(--wedding-paper);
        color: var(--wedding-ink);
        font: 16px var(--font-anonymous);
    }
    &__field::-webkit-search-cancel-button {
        appearance: none;
    }
    &__clear {
        position: absolute;
        right: 0;
        top: 0;
    }
    &__count {
        margin-block: 2rem 1rem;
        font-size: 1.5rem;
        color: var(--wedding-muted);
    }
    &__results {
        max-height: 44rem;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--wedding-line) transparent;
    }
    &__list {
        padding: 0;
        margin: 0;
        list-style: none;
    }
    &__empty {
        padding-block: 3rem;
        font-size: 1.75rem;
    }
    &__description {
        margin-block: 1rem 2rem;
        color: var(--wedding-muted);
    }

    &__field:focus-visible {
        outline: 2px solid var(--wedding-sage);
        outline-offset: -2px;
    }
}
@media (max-width: 900px) {
    .search__results {
        max-height: 32rem;
    }
}
