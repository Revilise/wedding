.zoom {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;

    &--isOutline & {
        &__container {
            border: 1px solid var(--colorBlackout30);
            border-radius: 2rem;
            padding: 2rem;
        }
    }

    &__container {
        width: 100%;
        overflow: hidden;
        touch-action: none;
    }

    &__image {
        display: block;
        max-width: 100%;
        height: auto;
    }

    &__controls {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }
}
