.header {
    --headerBg: rgba(250, 248, 243, 0.94);
    --headerColor: var(--colorBlackout);
    --headerJustifyContent: space-between;
    --headerPadX: calc(var(--viewport-padding));
    --headerPadY: 1.75rem;
    --headerBorderColor: var(--wedding-line);
    --headerInfoFontSize: 1.625rem;
    --headerInfoFontWeight: 500;
    --headerInfoLetterSpacing: 0.025em;
    /* wrapper */

    /* info */
    --headerInfoDisplay: flex;
    /* mixin separator */
    --separatorColor: var(--headerColor);
    --separatorHeight: 1.75rem;

    background: var(--headerBg);
    border-bottom: 1px solid var(--headerBorderColor);
    padding-block: var(--headerPadY);
    backdrop-filter: blur(1.375rem);
    position: sticky;
    width: 100%;
    top: 0;
    left: 0;
    z-index: 100;

    &__wrapper {
        align-items: center;
        padding-inline: var(--headerPadX);
        justify-content: var(--headerJustifyContent);
        max-width: var(--fluid-max-vw);
        margin-inline: auto;
        display: flex;
    }

    &__info {
        display: var(--headerInfoDisplay);
        color: var(--headerColor);
        gap: 3rem;
        align-items: center;
        font-size: var(--headerInfoFontSize);
        font-weight: var(--headerInfoFontWeight);
        letter-spacing: var(--headerInfoLetterSpacing);

        @media (--tablet) {
            grid-template-columns: min-content auto;
            gap: 0.5rem 2rem;

            & :nth-last-child(1) {
                grid-column: 1 / -1;
            }
        }
    }

    &__dateTime {
        display: flex;
        place-items: center;
        gap: 2rem;
        @apply --separator;
    }

    @media (--tablet) {
        --separatorColor: none;
        --headerInfoDisplay: grid;
    }

    @media (--mobile) {
        --headerInfoDisplay: none;
        --headerJustifyContent: center;
    }
}
