.section {
    --sectionBg: transparent;
    --sectionPadY: 0;
    --sectionPadX: var(--viewport-padding);
    --sectionMarY: 0 12rem;

    --sectionHeaderMaxWidth: var(--viewport-width);
    --sectionHeaderMarBottom: 3rem;
    --sectionHeaderDirection: column;
    --sectionHeadingPadX: 0;
    --sectionHeadingPadY: 0;

    --sectionWrapperDisplay: grid;
    --sectionWrapperTemplCols: 1fr;
    --sectionWrapperMaxWidth: var(--viewport-width);
    --sectionWrapperGap: 8px;
    --sectionWrapperPadX: 0;
    --sectionWrapperPadY: 0;

    background: var(--sectionBg);
    padding-inline: var(--sectionPadX);
    padding-block: var(--sectionPadY);
    margin-block: var(--sectionMarY);

    scroll-margin: 5rem;

    &__wrapper {
        max-width: var(--sectionWrapperMaxWidth);
        padding-inline: var(--sectionWrapperPadX);
        padding-block: var(--sectionWrapperPadY);
        grid-template-columns: var(--sectionWrapperTemplCols);
        display: var(--sectionWrapperDisplay);
        gap: var(--sectionWrapperGap);
        position: relative;
        flex-direction: column;
        margin-inline: auto;
    }

    &__heading {
        max-width: var(--sectionHeaderMaxWidth);
        margin-bottom: var(--sectionHeaderMarBottom);
        flex-direction: var(--sectionHeaderDirection);
        padding-inline: var(--sectionHeadingPadX);
        padding-block: var(--sectionHeadingPadY);
        gap: 16px;
        margin-inline: auto;
        display: flex;

        @media (--mobile) {
            --sectionHeaderDirection: column;
        }
    }

    @media (--mobile) {
        --sectionMarY: 0 8rem;
        --sectionPadX: 3rem;
        --sectionWrapperPadX: 0;
    }

    &--isLarge {
        --sectionWrapperMaxWidth: var(--fluid-max-vw);
        --sectionWrapperPadX: 0 !important;
    }

    &--isFull {
        --sectionWrapperMaxWidth: 1920px;
        --sectionWrapperPadX: 0 !important;
        --sectionPadX: 0 !important;
    }

    &--isMobFull {
        @media (--mobile) {
            --sectionWrapperMaxWidth: 100%;
            --sectionWrapperPadX: 0 !important;
            --sectionPadX: 0 !important;
        }
    }

    &--isImageBg {
        --sectionWrapperPadY: 4rem;
        background-repeat: no-repeat;
        background-size: cover;
        backdrop-filter: blur(100px);
        background-attachment: fixed;

        * {
            color: var(--colorWhite);
        }
    }

    &--isOliveDrabBg {
        --sectionPadY: 8rem;
        background-color: var(--colorOliveDrab);

        * {
            color: var(--colorWhite);
        }
    }

    &--isSweetGreyBg {
        --sectionBg: var(--colorSweetGrey30);
    }

    &--isWideVerticalPad {
        --sectionPadY: 10rem;
    }

    &--isDressCode & {
        &__heading {
            --sectionHeaderMarBottom: 3rem;
        }

        &__wrapper {
            display: flex;
            flex-direction: column;
            gap: 4rem;
        }
    }

    &--isCommunication & {
        &__wrapper {
            --sectionWrapperTemplCols: 1fr min-content;
            grid-template-columns: var(--sectionWrapperTemplCols);
            display: grid;
            gap: 3rem;

            @media (--mobile) {
                --sectionWrapperTemplCols: 1fr;
                place-items: center;
            }
        }
    }

    &--isTimePlace {
        --sectionHeaderDirection: row;
        --sectionWrapperTemplCols: 0.85fr 1.4fr;
        --sectionWrapperGap: 8rem;

        .align-right {
            text-align: left;
        }

        .image {
            aspect-ratio: 4 / 3;
        }

        @media (--mobile) {
            --sectionWrapperTemplCols: 1fr;
            --sectionWrapperGap: 3rem;
        }
    }

    &--isTimePlace & {
        &__heading {
            place-items: end;
        }
    }

    &--isSuggestions {
        --sectionPadX: 0;

        --sectionWrapperPadY: 2rem;
        --sectionWrapperPadX: 2rem;

        @media (--tablet) {
            --sectionHeadingPadX: 3rem;
        }
    }

    &--isSuggestions & {
        &__wrapper {
            border: 1px solid var(--colorSweetGrey);
            border-radius: 3rem;
        }
    }

    &--isGallery {
        --sectionWrapperDisplay: block;
        --sectionHeaderMarBottom: 4rem;
        --sectionPadY: 0;
    }
}

.section {
    --sectionMarY: 0 clamp(8rem, 9vw, 17rem);
    scroll-margin-top: 12rem;
}
.section .section__heading {
    --sectionHeaderMarBottom: 5rem;
}
.section .section__heading p {
    max-width: 68ch;
    color: var(--wedding-muted);
}
.section .section__wrapper {
    min-width: 0;
}
.section--isOliveDrabBg {
    background: var(--wedding-sage);
    --sectionPadY: clamp(7rem, 8vw, 12rem);
}
@media (max-width: 768px) {
    .section .section__heading {
        --sectionHeaderMarBottom: 3rem;
    }
}

/* Keep content visible in browsers without scroll-driven animations. */
@supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
        .section:not(.section--isWelcome) > .section__heading {
            animation: wedding-reveal linear both;
            animation-timeline: view();
            animation-range: entry 0% entry 100%;
        }
    }
}

.section--isWelcome {
    margin-top: 4rem;
}
.section--isWelcome .banner {
    height: auto;
    min-height: 76rem;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    grid-template-rows: 1fr auto;
    border-radius: 2px;
    background: var(--wedding-surface);
    color: var(--wedding-ink);
}
.section--isWelcome .banner__picture {
    grid-column: 2;
    grid-row: 1 / 3;
    min-height: 0;
}
.section--isWelcome .banner__picture img {
    display: block;
    object-position: center 40%;
}
.section--isWelcome .banner__title {
    position: static;
    padding: clamp(4rem, 5vw, 9rem) clamp(3rem, 4vw, 7rem) 4rem;
    align-self: end;
}
.section--isWelcome .h0 {
    font-size: clamp(6rem, 6.8vw, 12rem);
    line-height: 0.98;
    opacity: 1;
}
.section--isWelcome .banner__content {
    position: static;
    padding: 0 clamp(3rem, 4vw, 7rem) clamp(4rem, 5vw, 9rem);
    align-items: start;
    gap: 3rem;
}
.section--isWelcome h1 {
    font-family: var(--font-anonymous);
    font-size: 1.625rem;
    letter-spacing: 0.2em;
    line-height: 1.5;
    text-align: left;
}
.section--isWelcome h1 br {
    display: none;
}
.section--isWelcome h1 br::after {
    content: ' ';
}
.section--isWelcome .banner__content p {
    width: auto;
    max-width: 38ch;
    color: var(--wedding-muted);
}
@media (max-width: 768px) {
    .section--isWelcome {
        padding-inline: 2rem;
        margin-top: 2rem;
    }
    .section--isWelcome .banner {
        grid-template-columns: 1fr;
        min-height: 0;
    }
    .section--isWelcome .banner__title {
        padding: 5rem 3rem 3rem;
    }
    .section--isWelcome .banner__content {
        padding: 0 3rem 5rem;
    }
    .section--isWelcome .banner__picture {
        grid-column: 1;
        grid-row: 3;
        height: 48rem;
    }
    .section--isWelcome .h0 {
        font-size: clamp(6rem, 12vw, 9rem);
    }
}

.section--isGallery .section__heading {
    max-width: var(--fluid-max-vw);
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: end;
    gap: 6rem;
}
.section--isGallery .section__heading > * {
    text-align: left;
}
.section--isGallery .image {
    aspect-ratio: 4 / 5;
}
.section--isGallery .image img {
    height: 100%;
}

@media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .section--isGallery .image img {
        transition: transform 650ms cubic-bezier(0.2, 0.65, 0.3, 1);
    }
    .section--isGallery .image:hover img {
        transform: scale(1.025);
    }
}
@media (max-width: 768px) {
    .section--isGallery .section__heading {
        grid-template-columns: 1fr;
        gap: 3rem;
    }
}

.section--isOliveDrabBg .grid--isOffset {
    grid-template-columns: 1fr 1.25fr;
    gap: 8rem;
    align-items: start;
}
.section--isOliveDrabBg .grid__item {
    padding: 0;
}
.section--isOliveDrabBg .grid--isMinAuto {
    gap: 0 4rem;
}
.section--isOliveDrabBg .grid--isMinAuto > span {
    padding-block: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
}
.section--isOliveDrabBg .grid--isMinAuto > span:nth-child(odd) {
    font-variant-numeric: tabular-nums;
}
@media (max-width: 768px) {
    .section--isOliveDrabBg .grid--isOffset {
        gap: 4rem;
    }
}

.section--isSuggestions {
    --sectionPadX: var(--viewport-padding);
}
.section--isSuggestions .section__wrapper {
    padding: clamp(3rem, 4vw, 6rem);
    border: 1px solid var(--wedding-line);
    border-radius: 8px;
    background: var(--wedding-surface);
}
