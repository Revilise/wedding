.section {
    --sectionBg: transparent;
    --sectionColor: inherit;
    --sectionPadY: 0;
    --sectionPadX: var(--viewport-padding);
    --sectionHeaderMaxWidth: var(--viewport-width);
    --sectionHeaderMarBottom: 5rem;
    --sectionHeaderDirection: column;
    --sectionHeadingPadX: 0;
    --sectionHeadingPadY: 0;
    --sectionHeadingDisplay: flex;
    --sectionHeadingColumns: 1fr;
    --sectionHeadingGap: 16px;
    --sectionHeadingAlign: normal;
    --sectionWrapperDisplay: grid;
    --sectionWrapperTemplCols: 1fr;
    --sectionWrapperMaxWidth: var(--viewport-width);
    --sectionWrapperGap: 8px;
    --sectionWrapperPadX: 0;
    --sectionWrapperPadY: 0;
    --sectionWrapperBorder: 0;
    --sectionWrapperRadius: 0;
    --sectionWrapperBg: transparent;
    --sectionWrapperAlign: normal;

    background: var(--sectionBg);
    color: var(--sectionColor);
    padding-inline: var(--sectionPadX);
    padding-block: var(--sectionPadY);
    scroll-margin-top: 12rem;

    &__wrapper {
        max-width: var(--sectionWrapperMaxWidth);
        min-width: 0;
        padding-inline: var(--sectionWrapperPadX);
        padding-block: var(--sectionWrapperPadY);
        grid-template-columns: var(--sectionWrapperTemplCols);
        display: var(--sectionWrapperDisplay);
        gap: var(--sectionWrapperGap);
        position: relative;
        flex-direction: column;
        margin-inline: auto;
        border: var(--sectionWrapperBorder);
        border-radius: var(--sectionWrapperRadius);
        background: var(--sectionWrapperBg);
        place-items: var(--sectionWrapperAlign);
    }

    &__heading {
        max-width: var(--sectionHeaderMaxWidth);
        margin-bottom: var(--sectionHeaderMarBottom);
        flex-direction: var(--sectionHeaderDirection);
        padding-inline: var(--sectionHeadingPadX);
        padding-block: var(--sectionHeadingPadY);
        gap: var(--sectionHeadingGap);
        margin-inline: auto;
        display: var(--sectionHeadingDisplay);
        grid-template-columns: var(--sectionHeadingColumns);
        align-items: var(--sectionHeadingAlign);
    }

    @media (--mobile) {
        --sectionPadX: 3rem;
        --sectionWrapperPadX: 0;
        --sectionHeaderDirection: column;
        --sectionHeaderMarBottom: 3rem;
    }

    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            &__heading {
                animation: wedding-reveal linear both;
                animation-timeline: view();
                animation-range: entry 0% entry 100%;
            }
        }
    }

    &--isLarge {
        --sectionWrapperMaxWidth: var(--fluid-max-vw);
        --sectionWrapperPadX: 0;
    }
    &--isFull {
        --sectionWrapperMaxWidth: 1920px;
        --sectionWrapperPadX: 0;
        --sectionPadX: 0;
    }
    &--isMobFull {
        @media (--mobile) {
            --sectionWrapperMaxWidth: 100%;
            --sectionWrapperPadX: 0;
            --sectionPadX: 0;
        }
    }
    &--isMobInset {
        @media (--mobile) {
            --sectionPadX: 2rem;
        }
    }
    &--isImageBg {
        --sectionWrapperPadY: 4rem;
        --sectionColor: var(--colorWhite);
        background-repeat: no-repeat;
        background-size: cover;
        backdrop-filter: blur(100px);
        background-attachment: fixed;
    }
    &--isOliveDrabBg {
        --sectionPadY: clamp(7rem, 8vw, 12rem);
        --sectionBg: var(--wedding-sage);
        --sectionColor: var(--colorWhite);
    }
    &--isSweetGreyBg {
        --sectionBg: var(--colorSweetGrey30);
    }
    &--isWideVerticalPad {
        --sectionPadY: 10rem;
    }
    &--isStacked {
        --sectionWrapperDisplay: flex;
        --sectionWrapperGap: 4rem;
    }
    &--isAside {
        --sectionWrapperTemplCols: 1fr min-content;
        --sectionWrapperGap: 3rem;
        @media (--mobile) {
            --sectionWrapperTemplCols: 1fr;
            --sectionWrapperAlign: center;
        }
    }
    &--isTwoColumns {
        --sectionHeaderDirection: row;
        --sectionHeadingAlign: end;
        --sectionWrapperTemplCols: 0.85fr 1.4fr;
        --sectionWrapperGap: 8rem;
        @media (--mobile) {
            --sectionWrapperTemplCols: 1fr;
            --sectionWrapperGap: 3rem;
        }
    }
    &--isProgram {
        --sectionWrapperTemplCols: 1fr 1.25fr;
        --sectionWrapperGap: 8rem;
        --sectionWrapperAlign: start stretch;

        @media (--mobile) {
            --sectionWrapperTemplCols: 1fr;
            --sectionWrapperGap: 4rem;
        }
    }
    &--isBordered {
        --sectionWrapperPadY: clamp(3rem, 4vw, 6rem);
        --sectionWrapperPadX: clamp(3rem, 4vw, 6rem);
        --sectionWrapperBorder: 1px solid var(--wedding-line);
        --sectionWrapperRadius: 8px;
        --sectionWrapperBg: var(--wedding-surface);
        @media (--tablet) {
            --sectionHeadingPadX: 3rem;
        }
    }
    &--isSplitHeading {
        --sectionWrapperDisplay: block;
        --sectionHeaderMaxWidth: var(--fluid-max-vw);
        --sectionHeadingDisplay: grid;
        --sectionHeadingColumns: 1fr 1.2fr;
        --sectionHeadingAlign: end;
        --sectionHeadingGap: 6rem;
        @media (--mobile) {
            --sectionHeadingColumns: 1fr;
            --sectionHeadingGap: 3rem;
        }
    }
}
