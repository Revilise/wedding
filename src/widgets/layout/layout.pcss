.layout {
    --layoutSectionGap: clamp(8rem, 9vw, 17rem);
    --layoutContentTop: 4rem;

    width: 100%;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    @media (--mobile) {
        --layoutContentTop: 2rem;
    }

    &--isSpaced & {
        &__content {
            > .section {
                margin-block: 0 var(--layoutSectionGap);
            }

            > .section:first-child {
                margin-top: var(--layoutContentTop);
            }
        }
    }
}
