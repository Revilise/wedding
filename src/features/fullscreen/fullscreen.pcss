.fullscreen {
    &__wrapper {
        background: var(--colorBlackout30);
        max-height: 100vh;
        z-index: 100;
        position: fixed;
        inset: 0;
        overflow: hidden;
        display: block;
    }

    &__modal {
        padding: 3rem;
        height: 100%;
        width: 100%;
        overflow: hidden;
        position: relative;
    }

    &__content {
        overflow: hidden;
        height: inherit;
        width: 100%;
    }

    &__close {
        position: absolute;
        right: 3rem;
        top: 3rem;
    }
}