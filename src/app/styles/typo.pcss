:root {
    --font-angst: var(--font-source-serif);
    --font-anonymous: 'Manrope', Arial, sans-serif;
    --font-source-serif: 'Cormorant Garamond', Georgia, serif;

    --fluid-margin: calc((100% - var(--viewport-width)) / 2);
    --background-color: var(--wedding-paper);
    --viewport-padding: 4rem;
    --viewport-width: 120rem;

    --fluid-min-vw: 40rem;
    --fluid-max-vw: 152rem;
}

@font-face {
    src: url('../../../public/fonts/Angst-Bold.otf') format('opentype');
    font-family: 'angst';
    font-weight: 100;
    font-style: normal;
    src: url('../../../public/fonts/AnonymousPro-Bold.ttf') format('truetype');
    font-family: 'anonymous';
    font-weight: 700;
    font-style: normal;
    src: url('../../../public/fonts/AnonymousPro-Regular.ttf') format('truetype');
    font-family: 'anonymous';
    font-weight: 400;
    font-style: normal;
    src: url('../../../public/fonts/SourceSerifPro-Bold.ttf') format('truetype');
    font-family: 'source-serif';
    font-weight: 700;
    font-style: normal;
    src: url('../../../public/fonts/SourceSerifPro-Regular.ttf') format('truetype');
    font-family: 'source-serif';
    font-weight: 400;
    font-style: normal;
}

html {
    font-size: 8px;
}

body {
    --font-size: 2.5rem;
    font-size: var(--font-size);
    background: var(--background-color);
    font-family: var(--font-anonymous);
    line-height: 1.4;

    @media (--mobile) {
        --viewport-padding: 3rem;
    }
}

address {
    font-style: normal;
}

.h0 {
    font-size: 14rem;
    line-height: 1;
    font-family: var(--font-angst);

    @media (--tablet) {
        font-size: 10rem;
    }

    @media (--mobile) {
        font-size: 5rem;
    }
}

h1,
.h1,
h2,
.h2,
h3,
.h3,
h4,
.h4,
h5,
.h5 {
    line-height: 1.2;
}

h1,
.h1 {
    font-family: var(--font-source-serif);
    font-size: 14rem;
    line-height: 1;
    font-weight: normal;

    @media (--mobile) {
        font-size: 6.75rem;
    }

    @media (--smallMobile) {
        font-size: 6rem;
    }
}

h2,
.h2 {
    font-family: var(--font-source-serif);
    font-size: 9.375rem;
    line-height: 1;

    @media (--mobile) {
        font-size: 6.75rem;
    }

    @media (--smallMobile) {
        font-size: 6.75rem;
    }
}

h3,
.h3 {
    font-size: 6.25rem;
    line-height: 7.75rem;
    font-weight: bold;
    font-family: var(--font-source-serif);
}

h4,
.h4 {
    font-size: 5rem;
    line-height: 6.25rem;
    font-family: var(--font-source-serif);
    font-weight: normal;
}

a:not([class]) {
    color: var(--colorBurntSienna);
    font-weight: bold;
}

mark {
    background: var(--colorCoolHazel);
}

.special {
    font-family: var(--font-angst);
}

.text {
    font-size: 2.75rem;
    line-height: 3.75rem;
}

.text-2 {
    font-size: 2.75rem;
    line-height: 2.5rem;
}

.bold {
    font-weight: bold;
}

.align-right {
    text-align: right;
}

.align-center {
    text-align: center;
}

.colorWhite {
    color: var(--colorWhite);
}

.colorVintageCoral {
    color: var(--colorVintageCoral);
}

body {
    --font-size: 2.125rem;
    color: var(--wedding-ink);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
}

h1,
.h1,
h2,
.h2,
h3,
.h3,
h4,
.h4,
.h0 {
    font-family: var(--font-source-serif);
    font-weight: 400;
    letter-spacing: -0.035em;
    text-wrap: balance;
}

h2,
.h2 {
    font-size: clamp(5rem, 5vw, 8.5rem);
    line-height: 1.08;
}
h3,
.h3 {
    font-size: clamp(4rem, 4vw, 6rem);
    line-height: 1.2;
}
h4,
.h4 {
    font-size: clamp(3.5rem, 3vw, 5rem);
    line-height: 1.25;
}
body .text,
body .text-2 {
    font-size: 2.125rem;
    line-height: 1.7;
}
body a:not([class]) {
    color: var(--wedding-sage);
    text-underline-offset: 5px;
    font-weight: 500;
}
::selection {
    background: #dce2d5;
    color: var(--wedding-ink);
}
@media (max-width: 768px) {
    body {
        --viewport-padding: 3rem;
    }
}
