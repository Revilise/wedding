.section--isDressExamples .section__heading {
    max-width: var(--viewport-width);
    gap: 2rem;
}
.section--isDressExamples .section__heading p {
    max-width: 58ch;
}
.dress-examples {
    &__eyebrow {
        font-size: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--wedding-muted);
    }
    &__toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        padding-bottom: 3rem;
        margin-bottom: 4rem;
        border-bottom: 1px solid var(--wedding-line);
    }
    &__filters {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    &__filters button {
        min-height: 44px;
        padding: 1.25rem 2.5rem;
        border-radius: 999px;
        border: 1px solid var(--wedding-line);
        background: transparent;
        color: var(--wedding-muted);
        font: 1.75rem var(--font-anonymous);
        cursor: pointer;
    }
    &__filters button[aria-pressed='true'] {
        background: var(--wedding-sage);
        border-color: var(--wedding-sage);
        color: var(--wedding-paper);
    }
    &__count {
        flex-shrink: 0;
        font-size: 1.5rem;
        color: var(--wedding-muted);
    }
    &__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6rem 4rem;
        align-items: start;
    }
    &__card {
        margin: 0;
        min-width: 0;
    }
    &__card:nth-child(even) {
        padding-top: 7rem;
    }
    &__photo {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 5;
        position: relative;
        overflow: hidden;
        padding: 0;
        border: 0;
        border-radius: 4px;
        background: var(--wedding-surface);
        cursor: zoom-in;
    }
    &__photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    &__number {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: grid;
        place-items: center;
        width: 4.5rem;
        height: 4.5rem;
        border-radius: 50%;
        background: var(--wedding-paper);
        color: var(--wedding-ink);
        font: 1.5rem var(--font-anonymous);
    }
    &__expand {
        position: absolute;
        right: 2rem;
        bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 1.5rem 2rem;
        border-radius: 999px;
        background: var(--wedding-paper);
        color: var(--wedding-ink);
        font: 1.5rem var(--font-anonymous);
    }
    &__expand > span {
        font-size: 2rem;
    }
    &__meta {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        margin-block: 2.5rem 1.5rem;
        font-size: 1.35rem;
        color: var(--wedding-muted);
    }
    &__meta > span:first-child {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    &__meta i {
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
    }
    &__card h3 {
        font-family: var(--font-source-serif);
        font-size: clamp(3rem, 3vw, 4.5rem);
        font-weight: 400;
        line-height: 1.15;
        margin-bottom: 1rem;
    }
    &__card p {
        max-width: 42ch;
        color: var(--wedding-muted);
        font-size: 1.75rem;
        line-height: 1.6;
    }
    &__note {
        margin-top: 6rem;
        padding-block: 3rem;
        border-block: 1px solid var(--wedding-line);
        color: var(--wedding-muted);
        font-size: 1.75rem;
        text-align: center;
        text-wrap: balance;
    }
    button:focus-visible {
        outline: 2px solid var(--wedding-sage);
        outline-offset: 4px;
    }
}
.look-viewer {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 2rem;
    width: min(100rem, calc(100vw - 4rem));
    max-width: none;
    max-height: calc(100dvh - 4rem);
    border: 1px solid var(--wedding-line);
    border-radius: 8px;
    background: var(--wedding-paper);
    color: var(--wedding-ink);
    overflow-y: auto;
    &::backdrop {
        background: rgba(29, 34, 27, 0.8);
    }
    &__image {
        display: block;
        width: 100%;
        height: min(72dvh, 100rem);
        object-fit: contain;
    }
    &__close {
        position: absolute;
        right: 3rem;
        top: 3rem;
        border: 1px solid var(--wedding-line);
        border-radius: 50%;
        background: var(--wedding-paper);
        color: var(--wedding-ink);
        width: 44px;
        height: 44px;
        font-size: 3rem;
        cursor: pointer;
    }
    &__footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        padding: 2rem 1rem 0;
    }
    &__footer span {
        font-size: 1.5rem;
        color: var(--wedding-muted);
    }
    &__footer h3 {
        font: 3rem var(--font-source-serif);
    }
    &__controls {
        display: flex;
        gap: 1rem;
    }
    &__controls button {
        min-width: 44px;
        min-height: 44px;
        border: 1px solid var(--wedding-line);
        border-radius: 50%;
        background: transparent;
        color: var(--wedding-ink);
        font-size: 2.5rem;
        cursor: pointer;
    }
    button:focus-visible {
        outline: 2px solid var(--wedding-sage);
        outline-offset: 3px;
    }
}
@media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .dress-examples__photo img {
        transition: transform 450ms ease;
    }
    .dress-examples__photo:hover img {
        transform: scale(1.035);
    }
}
@media (max-width: 640px) {
    .dress-examples__toolbar {
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-bottom: 3rem;
    }
    .dress-examples__filters {
        gap: 0.5rem;
    }
    .dress-examples__filters button {
        padding-inline: 1.75rem;
        font-size: 1.5rem;
    }
    .dress-examples__grid {
        grid-template-columns: 1fr;
        gap: 4rem;
    }
    .dress-examples__card:nth-child(even) {
        padding-top: 0;
    }
    .dress-examples__photo {
        aspect-ratio: 1;
    }
    .dress-examples__note {
        margin-top: 4rem;
        text-align: left;
    }
    .look-viewer {
        padding: 1rem;
        width: calc(100vw - 2rem);
        max-height: calc(100dvh - 2rem);
    }
    .look-viewer__image {
        height: 68dvh;
    }
    .look-viewer__close {
        top: 2rem;
        right: 2rem;
    }
    .look-viewer__footer h3 {
        font-size: 2.5rem;
    }
}
