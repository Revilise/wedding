.seating-plan {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    border: 1px solid var(--wedding-line);
    border-radius: 8px;
    overflow: hidden;
    &__map {
        padding: clamp(2rem, 3vw, 4rem);
        background: var(--wedding-surface);
        min-width: 0;
    }
    &__heading {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        align-items: baseline;
        margin-bottom: 4rem;
        font-family: var(--font-source-serif);
        font-size: 3.5rem;
    }
    &__heading > span:last-child {
        font: 1.4rem var(--font-anonymous);
        color: var(--wedding-muted);
    }
    .zoom__container {
        background: var(--wedding-paper);
        border-radius: 4px;
    }
    .zoom__image {
        width: 100%;
    }

    &__hint {
        margin-block: 2rem 3rem;
        color: var(--wedding-muted);
        font-size: 1.5rem;
    }
    &__selection {
        border-top: 1px solid var(--wedding-line);
        padding-top: 3rem;
        display: flex;
        gap: 2rem;
        align-items: center;
        min-height: 11rem;
    }
    &__selection p,
    &__selection div > span {
        color: var(--wedding-muted);
        font-size: 1.5rem;
    }
    &__selection strong {
        display: block;
        font-family: var(--font-source-serif);
        font-size: 3rem;
    }
    &__place {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 7rem;
        height: 7rem;
        border-radius: 50%;
        background: var(--wedding-sage);
        color: var(--wedding-paper);
        font-size: 3rem;
    }
    &__directory {
        min-width: 0;
        padding: clamp(2rem, 3vw, 4rem);
    }

    &__badge {
        flex-shrink: 0;
        color: var(--wedding-muted);
        font-size: 1.25rem;
    }
    &__badge b {
        display: inline-grid;
        place-items: center;
        width: 3.5rem;
        height: 3.5rem;
        margin-left: 0.5rem;
        border: 1px solid var(--wedding-line);
        border-radius: 50%;
        color: var(--wedding-sage);
        font-size: 1.5rem;
    }
    &__guest[aria-pressed='true'] b {
        background: var(--wedding-sage);
        color: var(--wedding-paper);
    }
    input:focus-visible {
        outline: 2px solid var(--wedding-sage);
        outline-offset: -2px;
    }
}
@media (max-width: 900px) {
    .seating-plan {
        grid-template-columns: 1fr;
    }
    .seating-plan__directory {
        grid-row: 1;
    }
}
