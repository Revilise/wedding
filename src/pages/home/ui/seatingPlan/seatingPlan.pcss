.seating-plan {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    border: 1px solid var(--wedding-line);
    border-radius: 8px;
    overflow: hidden;
    &__map {
        padding: clamp(2rem, 3vw, 4rem);
        background: var(--wedding-surface);
        min-width: 0;
    }
    &__heading {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        align-items: baseline;
        margin-bottom: 4rem;
        font-family: var(--font-source-serif);
        font-size: 3.5rem;
    }
    &__heading > span:last-child {
        font: 1.4rem var(--font-anonymous);
        color: var(--wedding-muted);
    }
    .zoom__container {
        background: var(--wedding-paper);
        border-radius: 4px;
    }
    .zoom__image {
        width: 100%;
    }
    .zoom__btn {
        min-width: 44px;
        min-height: 44px;
        background: var(--wedding-paper);
        border-color: var(--wedding-line);
    }
    &__hint {
        margin-block: 2rem 3rem;
        color: var(--wedding-muted);
        font-size: 1.5rem;
    }
    &__selection {
        border-top: 1px solid var(--wedding-line);
        padding-top: 3rem;
        display: flex;
        gap: 2rem;
        align-items: center;
        min-height: 11rem;
    }
    &__selection p,
    &__selection div > span {
        color: var(--wedding-muted);
        font-size: 1.5rem;
    }
    &__selection strong {
        display: block;
        font-family: var(--font-source-serif);
        font-size: 3rem;
    }
    &__place {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 7rem;
        height: 7rem;
        border-radius: 50%;
        background: var(--wedding-sage);
        color: var(--wedding-paper);
        font-size: 3rem;
    }
    &__directory {
        min-width: 0;
        padding: clamp(2rem, 3vw, 4rem);
    }
    &__directory label {
        display: block;
        font-family: var(--font-source-serif);
        font-size: 3.5rem;
        margin-bottom: 2rem;
    }
    &__search {
        position: relative;
    }
    &__search input {
        width: 100%;
        min-height: 52px;
        padding: 1.5rem 5.5rem 1.5rem 1.5rem;
        border: 1px solid var(--wedding-line);
        border-radius: 4px;
        background: var(--wedding-paper);
        color: var(--wedding-ink);
        font: 16px var(--font-anonymous);
    }
    &__search input::-webkit-search-cancel-button {
        appearance: none;
    }
    &__search button {
        position: absolute;
        right: 0;
        top: 0;
        height: 100%;
        width: 44px;
        border: 0;
        background: transparent;
        color: var(--wedding-muted);
        font-size: 3rem;
        cursor: pointer;
    }
    &__count {
        margin-block: 2rem 1rem;
        font-size: 1.5rem;
        color: var(--wedding-muted);
    }
    &__results {
        max-height: 44rem;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--wedding-line) transparent;
    }
    &__results ul {
        padding: 0;
        margin: 0;
        list-style: none;
    }
    &__results li button {
        display: flex;
        justify-content: space-between;
        gap: 1.5rem;
        align-items: center;
        width: 100%;
        padding: 1.5rem 1rem;
        min-height: 52px;
        text-align: left;
        border: 0;
        border-bottom: 1px solid var(--wedding-line);
        background: transparent;
        font: 1.75rem var(--font-anonymous);
        color: var(--wedding-ink);
        cursor: pointer;
    }
    &__results li button:hover,
    &__results li button[aria-pressed='true'] {
        background: var(--wedding-surface);
    }
    &__badge {
        flex-shrink: 0;
        color: var(--wedding-muted);
        font-size: 1.25rem;
    }
    &__badge b {
        display: inline-grid;
        place-items: center;
        width: 3.5rem;
        height: 3.5rem;
        margin-left: 0.5rem;
        border: 1px solid var(--wedding-line);
        border-radius: 50%;
        color: var(--wedding-sage);
        font-size: 1.5rem;
    }
    &__results li button[aria-pressed='true'] b {
        background: var(--wedding-sage);
        color: var(--wedding-paper);
    }
    &__empty {
        padding-block: 3rem;
        font-size: 1.75rem;
    }
    &__empty p {
        margin-block: 1rem 2rem;
        color: var(--wedding-muted);
    }
    &__empty button {
        padding: 1rem;
        min-height: 44px;
        border: 1px solid var(--wedding-line);
        background: var(--wedding-surface);
        font: inherit;
        color: var(--wedding-ink);
        cursor: pointer;
    }
    button:focus-visible,
    input:focus-visible {
        outline: 2px solid var(--wedding-sage);
        outline-offset: -2px;
    }
}
@media (max-width: 900px) {
    .seating-plan {
        grid-template-columns: 1fr;
    }
    .seating-plan__directory {
        grid-row: 1;
    }
    .seating-plan__results {
        max-height: 32rem;
    }
}
